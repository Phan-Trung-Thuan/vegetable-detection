# Environment Configuration for Docker Deployment
# Copy to .env and modify as needed
# Used by docker-compose.yml and Docker containers

# ============================================================
# GENERAL SETTINGS
# ============================================================

# Project name (used as prefix for container names)
COMPOSE_PROJECT_NAME=veggie-detection

# Docker image tags
GPU_IMAGE_TAG=gpu
CPU_IMAGE_TAG=cpu
JUPYTER_IMAGE_TAG=jupyter
EXPORT_IMAGE_TAG=export

# ============================================================
# GPU SETTINGS
# ============================================================

# NVIDIA CUDA devices to use (0,1 for multi-GPU)
CUDA_VISIBLE_DEVICES=0

# NVIDIA driver capabilities
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Number of GPU cores to use (0 = auto)
NVIDIA_GPU_COUNT=1

# ============================================================
# INFERENCE SETTINGS
# ============================================================

# Model to use
MODEL=yolov11s.pt

# Confidence threshold
CONFIDENCE=0.5

# Image size
IMAGE_SIZE=640

# Batch size
BATCH_SIZE=32

# Number of workers for data loading
WORKERS=4

# ============================================================
# TRAINING SETTINGS
# ============================================================

# Training model configuration
TRAIN_MODEL=yolov11s.yaml

# Number of training epochs
EPOCHS=100

# Training batch size
TRAIN_BATCH=32

# Learning rate
LR0=0.01

# Momentum
MOMENTUM=0.9

# Optimizer (SGD, Adam, AdamW)
OPTIMIZER=SGD

# ============================================================
# PATH SETTINGS (relative to project root)
# ============================================================

# Data directory
DATA_PATH=./data

# Weights/models directory
WEIGHTS_PATH=./weights

# Output directory for predictions
OUTPUT_PATH=./runs

# Notebooks directory
NOTEBOOKS_PATH=./notebooks

# ============================================================
# JUPYTER SETTINGS
# ============================================================

# Jupyter port
JUPYTER_PORT=8888

# Jupyter token (empty for no authentication)
JUPYTER_TOKEN=

# Enable Jupyter Lab
JUPYTER_ENABLE_LAB=yes

# ============================================================
# API SETTINGS (if using inference server)
# ============================================================

# API server port
API_PORT=8000

# API host
API_HOST=0.0.0.0

# Max workers for API
API_WORKERS=4

# ============================================================
# DATABASE SETTINGS (optional, for experiment tracking)
# ============================================================

# PostgreSQL settings
POSTGRES_USER=veggie
POSTGRES_PASSWORD=veggie-pass
POSTGRES_DB=veggie-tracking
POSTGRES_PORT=5432

# MLflow settings
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=postgresql://veggie:veggie-pass@postgres:5432/veggie-tracking

# ============================================================
# RESOURCE LIMITS
# ============================================================

# CPU limit per container (e.g., '4' for 4 cores, '0' for unlimited)
CPU_LIMIT=0

# Memory limit per container (e.g., '8g', '4096m', '0' for unlimited)
MEMORY_LIMIT=0

# ============================================================
# LOGGING
# ============================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Python dont write bytecode
PYTHONDONTWRITEBYTECODE=1

# Python unbuffered output
PYTHONUNBUFFERED=1

# ============================================================
# HARDWARE ACCELERATION
# ============================================================

# Enable NVIDIA GPU support
USE_GPU=true

# GPU architecture (tesla, ampere, ada, hopper)
GPU_ARCH=auto

# ============================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode
DEBUG=false

# ============================================================
# CUSTOM SETTINGS
# ============================================================

# Add any custom environment variables below:
# MY_CUSTOM_VAR=value
